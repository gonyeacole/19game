generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id           String   @id @default(cuid())
  name         String // e.g. "Kansas City Chiefs"
  abbreviation String   @unique // e.g. "KC"
  logoUrl      String?
  espnId       String?  @unique // ESPN team id, used to match scoreboard data

  player Player?

  homeGames Game[] @relation("HomeTeam")
  awayGames Game[] @relation("AwayTeam")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id             String  @id @default(cuid())
  name           String
  venmoUsername  String?
  teamId         String  @unique
  team           Team    @relation(fields: [teamId], references: [id])

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Week {
  id         String @id @default(cuid())
  seasonYear Int
  weekNumber Int

  games    Game[]
  payments Payment[]

  // Last time we actually hit the score provider for this week (as opposed
  // to serving cached DB data) — used to throttle calls against the free
  // API-Sports tier's daily request cap.
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonYear, weekNumber])
}

model Payment {
  id       String   @id @default(cuid())
  playerId String
  player   Player   @relation(fields: [playerId], references: [id])
  weekId   String
  week     Week     @relation(fields: [weekId], references: [id])
  amount   Float    @default(10)
  paid     Boolean  @default(false)
  paidDate DateTime?
  // Manually confirmed by the admin (not derived from live scores) — this
  // player's team hit exactly 19 and won that week's pot.
  won      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, weekId])
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}

// Group chat. No login system exists for regular users, so authorName is a
// self-picked display name persisted client-side (localStorage), not tied to
// any Player/account record.
model Message {
  id         String   @id @default(cuid())
  authorName String
  body       String
  createdAt  DateTime @default(now())

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[] @relation("MessageReplies")

  reactions MessageReaction[]

  @@index([createdAt])
  @@index([replyToId])
}

// One row per (message, person, emoji) — a person can react to the same
// message with more than one distinct emoji, but not stack the same emoji
// twice. Reacting again with the same emoji is a toggle handled in the API
// route (delete the existing row instead of erroring on the unique
// constraint), not represented as its own state here.
model MessageReaction {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id])
  authorName String
  emoji      String
  createdAt  DateTime @default(now())

  @@unique([messageId, authorName, emoji])
  @@index([messageId])
}

// SQLite has no native enum support in Prisma, so GameStatus is stored as a
// String constrained in application code to: "SCHEDULED" | "IN_PROGRESS" | "FINAL"
model Game {
  id         String     @id @default(cuid())
  weekId     String
  week       Week       @relation(fields: [weekId], references: [id])
  espnGameId String?    @unique

  homeTeamId String
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  homeScore Int     @default(0)
  awayScore Int     @default(0)
  status    String  @default("SCHEDULED")
  statusDetail String? // e.g. "Final", "Final/OT", "Q3 4:12"
  situation    String? // down & distance / field position, e.g. "3rd & 9 at MIN 26" — IN_PROGRESS only
  possession   String? // abbreviation of the team with the ball — IN_PROGRESS only
  startTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekId])
}
